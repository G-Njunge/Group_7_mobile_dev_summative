rules_version = '2';

// TEMPORARY rules so auth can be developed. M5 replaces these with the full
// rules for every collection (see the Firestore contract in README.md).
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-only access to your own profile doc (doc ID = Firebase Auth uid).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pharmacy map (M4). Contract: signed-in read, no client write.
    match /pharmacies/{pharmacyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users may create their own counterfeit reports from the app.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.pharmacyId is string
        && request.resource.data.pharmacyId.size() > 0;
    }

    // Everything else stays locked until M5's rules land.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
