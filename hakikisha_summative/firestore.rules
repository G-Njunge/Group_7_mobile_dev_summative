rules_version = '2';

// Hakikisha Firestore security rules.
//
// Deny by default: anything not matched below is locked.
// Personal data is readable and writable only by its owner.
// Reference data is read-only for signed-in users.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    function hasShape(required, optional) {
      return data().keys().hasAll(required)
        && data().keys().hasOnly(required.concat(optional));
    }

    function unchanged(keys) {
      return !data().diff(resource.data).affectedKeys().hasAny(keys);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(value, max) {
      return value == null || isText(value, 0, max);
    }

    function isNow(value) {
      return value == request.time;
    }

    match /users/{uid} {
      function validUser() {
        return hasShape(
            ['uid', 'fullName', 'email', 'authProvider', 'createdAt'],
            ['phone', 'photoUrl'])
          && data().uid == uid
          && isText(data().fullName, 1, 100)
          && isText(data().email, 3, 254)
          && data().authProvider in ['password', 'google']
          && isOptionalText(data().get('phone', null), 20)
          && isOptionalText(data().get('photoUrl', null), 2048);
      }

      allow read, delete: if isUser(uid);
      allow create: if isUser(uid) && validUser() && isNow(data().createdAt);
      allow update: if isUser(uid)
        && validUser()
        && unchanged(['uid', 'email', 'authProvider', 'createdAt']);
    }

    match /medicines/{medicineId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /batches/{batchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /pharmacies/{pharmacyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /scans/{scanId} {
      allow read, delete: if isUser(resource.data.userId);
      allow create: if isUser(data().userId)
        && hasShape(['userId', 'result', 'method', 'scannedAt'], ['scanId', 'batchId'])
        && data().get('scanId', scanId) == scanId
        && isOptionalText(data().get('batchId', null), 128)
        && data().result in ['genuine', 'flagged', 'notFound']
        && data().method in ['camera', 'manual', 'upload']
        && isNow(data().scannedAt);
      allow update: if false;
    }

    match /reports/{reportId} {
      function validReport() {
        return hasShape(
            ['userId', 'description', 'photoUrls', 'status', 'createdAt', 'updatedAt'],
            ['reportId', 'scanId', 'pharmacyId'])
          && data().get('reportId', reportId) == reportId
          && isText(data().description, 1, 2000)
          && data().photoUrls is list
          && data().photoUrls.size() <= 3
          && isOptionalText(data().get('scanId', null), 128)
          && isOptionalText(data().get('pharmacyId', null), 128)
          && data().status == 'pending'
          && isNow(data().updatedAt);
      }

      function isPending() {
        return resource.data.status == 'pending';
      }

      allow read: if isUser(resource.data.userId);
      allow create: if isUser(data().userId)
        && validReport()
        && isNow(data().createdAt);
      allow update: if isUser(resource.data.userId)
        && isPending()
        && validReport()
        && unchanged(['userId', 'createdAt']);
      allow delete: if isUser(resource.data.userId) && isPending();
    }
  }
}
