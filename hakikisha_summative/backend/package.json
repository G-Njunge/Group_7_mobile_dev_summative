{
  "name": "hakikisha-backend",
  "private": true,
  "description": "Security rules tests and seed data for the Hakikisha Firebase project.",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --project demo-hakikisha --only firestore,storage --config ../firebase.json \"node --test test/*.test.mjs\"",
    "seed": "node seed/seed.mjs",
    "seed:emulator": "firebase emulators:exec --project demo-hakikisha --only firestore --config ../firebase.json \"node seed/seed.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
